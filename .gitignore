# Local evidence store. Never commit raw runs or content-addressed objects.
.evidence/
evidence/objects/
evidence/private/
evidence/runs/
data/
datasets/
artifacts/
checkpoints/
results/raw/
tmp/

# Secrets and machine-local configuration.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

