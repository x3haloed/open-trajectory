*.arrow
*.bin
*.ckpt
*.gguf
*.h5
*.hdf5
*.npy
*.npz
*.onnx
*.parquet
*.pt
*.pth
*.safetensors
*.sqlite
*.sqlite3
*.tar
*.tar.gz
*.tgz
*.zip

# Python and editor state.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
.DS_Store
