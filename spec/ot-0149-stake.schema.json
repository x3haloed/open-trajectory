{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "files_changed", "selected_property"],
  "properties": {
    "note": {"type": "string", "minLength": 1},
    "files_changed": {"type": "array", "items": {"type": "string", "const": "next-stake.json"}, "minItems": 1, "maxItems": 1},
    "selected_property": {"type": "string", "enum": ["continuity-under-reset", "option-expansion", "correction-from-error"]}
  }
}
