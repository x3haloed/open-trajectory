{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "files_changed", "selector_symbol"],
  "properties": {
    "note": {"type": "string", "minLength": 1},
    "files_changed": {
      "type": "array",
      "items": {"type": "string", "enum": ["selector.py"]},
      "minItems": 1,
      "maxItems": 1
    },
    "selector_symbol": {"type": "string", "enum": ["select"]}
  }
}
