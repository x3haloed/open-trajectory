{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "files_changed", "next_pursuit"],
  "properties": {
    "note": {"type": "string", "minLength": 1},
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["verify_coverage.py", "successor-opening.json"]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "next_pursuit": {"type": "string", "minLength": 1}
  }
}
