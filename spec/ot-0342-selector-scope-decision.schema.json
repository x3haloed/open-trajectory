{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {"type": "string", "const": "resolve-selector-scope"},
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["selector-scope-decision.json", "stake-revision.json"]
      },
      "minItems": 1,
      "maxItems": 2
    },
    "note": {"type": "string", "minLength": 1, "maxLength": 500}
  },
  "required": ["action", "files_changed", "note"],
  "additionalProperties": false
}
