{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "files_changed", "next_pursuit"],
  "properties": {
    "action": {"type": "string", "const": "author-semantic-move"},
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["operations/system.py", "move-package.json"]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "next_pursuit": {"type": "string", "minLength": 1}
  }
}
