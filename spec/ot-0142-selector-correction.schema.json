{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "files_changed", "selected_feature"],
  "properties": {
    "note": {"type": "string", "minLength": 1},
    "files_changed": {
      "type": "array",
      "items": {"type": "string", "enum": ["selector-semantics.json"]},
      "minItems": 1,
      "maxItems": 1
    },
    "selected_feature": {"type": "string", "enum": ["scale_invariant", "lower_mutation_surface"]}
  }
}
