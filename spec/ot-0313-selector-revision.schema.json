{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["action", "files_changed", "note"],
  "additionalProperties": false,
  "properties": {
    "action": {"enum": ["revise-selection-machinery", "retain-selection-machinery"]},
    "files_changed": {
      "type": "array",
      "items": {"const": "selector-revision.json"},
      "maxItems": 1,
      "uniqueItems": true
    },
    "note": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}
