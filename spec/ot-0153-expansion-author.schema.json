{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "files_changed", "property_id"],
  "properties": {
    "note": {"type": "string", "minLength": 1},
    "files_changed": {
      "type": "array",
      "items": {"type": "string", "enum": ["property.json", "operation.py"]},
      "minItems": 2,
      "maxItems": 2
    },
    "property_id": {"type": "string", "minLength": 3, "maxLength": 64}
  }
}
