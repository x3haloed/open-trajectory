{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-trajectory.invalid/spec/ot-0-promoted-run.schema.json",
  "title": "Promoted OT-0 encounter run",
  "allOf": [
    { "$ref": "https://open-trajectory.invalid/spec/encounter-run.schema.json" },
    {
      "type": "object",
      "properties": {
        "model": {
          "oneOf": [
            {
              "properties": {
                "stability": { "const": "immutable-revision" }
              }
            },
            {
              "required": ["deployment_epoch"],
              "properties": {
                "stability": { "const": "hosted-deployment-epoch" }
              }
            }
          ]
        }
      }
    }
  ]
}
