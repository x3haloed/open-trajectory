{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "files_changed", "world_id"],
  "properties": {
    "action": {"type": "string", "const": "author-world-package"},
    "files_changed": {
      "type": "array",
      "items": {"type": "string", "enum": ["world-package.json"]},
      "minItems": 1,
      "maxItems": 1
    },
    "world_id": {"type": "string", "minLength": 3, "maxLength": 64}
  }
}
