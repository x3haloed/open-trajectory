{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "files_changed", "note"],
  "properties": {
    "action": {"type": "string", "const": "author-selector-cost-world"},
    "files_changed": {
      "type": "array",
      "items": {"type": "string", "const": "world-portfolios.json"},
      "minItems": 1,
      "maxItems": 1
    },
    "note": {"type": "string", "minLength": 1}
  }
}
