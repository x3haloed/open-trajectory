{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {"type": "string", "const": "realize-delayed-continuation-contact"},
    "files_changed": {
      "type": "array",
      "items": {"type": "string", "const": "source.py"},
      "minItems": 1,
      "maxItems": 1
    },
    "note": {"type": "string", "minLength": 1, "maxLength": 500}
  },
  "required": ["action", "files_changed", "note"],
  "additionalProperties": false
}
