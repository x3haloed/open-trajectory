{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "files_changed", "selected_target"],
  "properties": {
    "action": {"type": "string", "const": "select-expanded-opportunity"},
    "files_changed": {
      "type": "array",
      "items": {"type": "string", "enum": ["expanded-selection.json"]},
      "minItems": 1,
      "maxItems": 1
    },
    "selected_target": {"type": "string", "minLength": 1}
  }
}
