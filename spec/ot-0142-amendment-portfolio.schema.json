{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "files_changed", "candidate_count"],
  "properties": {
    "note": {"type": "string", "minLength": 1},
    "files_changed": {
      "type": "array",
      "items": {"type": "string", "enum": ["amendment-portfolio.json"]},
      "minItems": 1,
      "maxItems": 1
    },
    "candidate_count": {"type": "integer", "const": 2}
  }
}
