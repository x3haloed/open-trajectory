{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "files_changed", "interface_id", "case_count"],
  "properties": {
    "note": {"type": "string", "minLength": 1},
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["interface.json", "operation.py", "conformance.py", "contact.json"]
      },
      "minItems": 4,
      "maxItems": 4
    },
    "interface_id": {"const": "joint-capability-frontier"},
    "case_count": {"const": 3}
  }
}
