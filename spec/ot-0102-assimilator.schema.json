{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "files_changed", "selected_interface"],
  "properties": {
    "note": {"type": "string", "minLength": 1},
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["assimilation.json", "successor-opening.json", "next-interface.json"]
      },
      "minItems": 3,
      "maxItems": 3
    },
    "selected_interface": {
      "type": "string",
      "enum": ["joint-boundary-probe", "allocator-challenge"]
    }
  }
}
