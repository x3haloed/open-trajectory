{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "files_changed", "disposition"],
  "properties": {
    "note": {"type": "string", "minLength": 1},
    "files_changed": {"type": "array", "items": {"type": "string", "const": "assimilation.json"}, "minItems": 1, "maxItems": 1},
    "disposition": {"type": "string", "const": "retire"}
  }
}
