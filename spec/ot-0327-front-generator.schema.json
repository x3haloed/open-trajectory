{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["action", "files_changed", "note"],
  "additionalProperties": false,
  "properties": {
    "action": {"const": "author-contact-front-generator"},
    "files_changed": {
      "type": "array",
      "items": {"type": "string", "const": "front-generator.py"},
      "minItems": 1,
      "maxItems": 1
    },
    "note": {"type": "string", "minLength": 1, "maxLength": 500}
  }
}
